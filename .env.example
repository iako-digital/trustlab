# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (/api/analyze + AI suggestions: admin-only; /api/chat and /api/tts: public, rate-limited). SERVER ONLY.
GEMINI_API_KEY=
# Optional backup keys, comma-separated. On 429 (quota) or 401/403 (rejected key) the next key is tried.
# Keep real keys in .env.local / Vercel env only, never in the repo.
GEMINI_API_KEYS=
# Optional dedicated keys (each falls back to GEMINI_API_KEY when empty):
GEMINI_TRANSLATE_KEY=   # admin auto-translate
GEMINI_SEARCH_KEY=      # Google Search grounding: admin verify agent + /api/verify-realtime
GEMINI_VERIFY_KEY=      # verdict reasoning: admin verify agent + /api/verify-realtime
GEMINI_MODEL=gemini-flash-latest
# Text-to-speech fallback (/api/tts) for languages the browser has no voice for.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Bot links on the home page (public values, safe in the browser).
# Telegram bot username without "@" (default cdc_support_alert_bot).
NEXT_PUBLIC_TELEGRAM_BOT=cdc_support_alert_bot
# Canonical site origin used in links the bot sends (default https://trustlab-iota.vercel.app).
NEXT_PUBLIC_SITE_URL=
# Telegram bot webhook (SERVER ONLY). Token from @BotFather; secret = any 16+ chars of A-Za-z0-9_-.
# Register with: node --env-file=.env.local scripts/set-telegram-webhook.mjs https://your-site
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp number in international format, digits only, e.g. 995555123456.
# Leave empty until the number exists: the button then shows a "coming soon" note.
NEXT_PUBLIC_WHATSAPP_NUMBER=
