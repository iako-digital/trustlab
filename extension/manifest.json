{
  "manifest_version": 3,
  "name": "TrustLab",
  "version": "0.1.0",
  "description": "Shows TrustLab fact-check badges on matching Facebook and Telegram posts.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "<all_urls>",
    "https://trustlab-iota.vercel.app/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["matcher.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.telegram.org/*", "https://t.me/s/*"],
      "js": ["matcher.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TrustLab",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" },
    "default_popup": "popup.html"
  }
}
